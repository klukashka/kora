+
+
+def available(descriptor: int, prefix: bytes = b"") -> CapturedStream:
+    captured = bytearray(prefix)
+    os.set_blocking(descriptor, False)
+    while len(captured) <= CAPTURE_LIMIT:
+        try:
+            chunk = os.read(descriptor, min(4096, CAPTURE_LIMIT + 1 - len(captured)))
+        except BlockingIOError:
+            break
+        if not chunk:
+            break
+        captured.extend(chunk)
+    return CapturedStream(
+        data=bytes(captured[:CAPTURE_LIMIT]).decode("utf-8", errors="replace"),
+        truncated=len(captured) > CAPTURE_LIMIT,
+    )
+
+
+@dataclass
+class NativeStartupChild:
+    process: subprocess.Popen[bytes]
+    readiness_stream: BinaryIO
+    diagnostics: int
+    diagnostic_bytes: bytearray = field(default_factory=bytearray)
+
+    @property
+    def readiness(self) -> int:
+        return self.readiness_stream.fileno()
+
+    def activate(self) -> None:
+        assert self.process.stdin is not None
+        self.process.stdin.write(b"G")
+        self.process.stdin.flush()
+
+    def stop(self) -> None:
+        assert self.process.stdin is not None
+        self.process.stdin.write(b"X")
+        self.process.stdin.flush()
+
+    def wait_registered(self) -> None:
+        deadline = time.monotonic() + CONDITION_SECONDS
+        parsed = 0
+        while True:
+            readable, _, _ = select.select(
+                [self.diagnostics], [], [], max(0.0, deadline - time.monotonic())
+            )
+            if not readable:
+                raise TimeoutError("native registration event deadline")
+            chunk = os.read(
+                self.diagnostics,
+                min(4096, CAPTURE_LIMIT + 1 - len(self.diagnostic_bytes)),
+            )
+            self.diagnostic_bytes.extend(chunk)
+            if len(self.diagnostic_bytes) > CAPTURE_LIMIT:
+                raise RuntimeError("native diagnostic capture bound")
+            if not chunk:
+                raise RuntimeError("native diagnostics closed before registration")
+            while (end := self.diagnostic_bytes.find(b"\n", parsed)) >= 0:
+                event = DiagnosticEvent.model_validate_json(
+                    bytes(self.diagnostic_bytes[parsed:end])
+                )
+                parsed = end + 1
+                if event.event == REGISTERED.name:
+                    return
+            if time.monotonic() >= deadline:
+                raise TimeoutError("native registration event deadline")
+
+    def read(self, descriptor: int, count: int) -> bytes:
+        deadline = time.monotonic() + READY_DEADLINE_SECONDS
+        remaining = count
+        chunks: list[bytes] = []
+        while remaining:
+            readable, _, _ = select.select(
+                [descriptor], [], [], max(0.0, deadline - time.monotonic())
+            )
+            if not readable:
+                raise TimeoutError("native child channel")
+            chunk = os.read(descriptor, remaining)
+            if not chunk:
+                break
+            chunks.append(chunk)
+            remaining -= len(chunk)
+        return b"".join(chunks)
+
+
+@contextmanager
+def native_startup_child(
+    root: Path, domain: str, nonce: str, mode: str
+) -> Generator[NativeStartupChild]:
+    environment = runner_environment(sys.platform, Path.home())
+    environment["PYTHONDONTWRITEBYTECODE"] = "1"
+    with ExitStack() as resources:
+        with ExitStack() as inherited:
+            ready_read, ready_write = os.pipe()
+            readiness_stream = resources.enter_context(
+                os.fdopen(ready_read, "rb", buffering=0)
+            )
+            inherited.callback(os.close, ready_write)
+            diagnostic_read, diagnostic_write = os.pipe()
+            resources.callback(os.close, diagnostic_read)
+            inherited.callback(os.close, diagnostic_write)
+            argv = [
+                sys.executable,
+                "-m",
+                "tests.plugins.runtime.local.startup_native_child",
+                str(root),
+                domain,
+                nonce,
+                mode,
+                str(ready_write),
+                str(diagnostic_write),
+            ]
+            process = subprocess.Popen(
+                argv,
+                stdin=subprocess.PIPE,
+                stdout=subprocess.PIPE,
+                stderr=subprocess.PIPE,
+                pass_fds=(ready_write, diagnostic_write),
+                env=environment,
+                start_new_session=False,
+            )
+        for stream in (process.stdin, process.stdout, process.stderr):
+            if stream is not None:
+                resources.callback(stream.close)
+        child = NativeStartupChild(process, readiness_stream, diagnostic_read)
+        try:
+            assert process.stdout is not None
+            assert (
+                child.read(process.stdout.fileno(), len(b"prepared\n")) == b"prepared\n"
+            )
+            yield child
+        finally:
+            failure = sys.exception()
+            before = process.poll()
+            try:
+                if before is None:
+                    process.kill()
+                process.wait(timeout=READY_DEADLINE_SECONDS)
+            finally:
+                outcome = sys.exception()
+                if outcome is not None or failure is not None:
+                    assert process.stdout is not None
+                    assert process.stderr is not None
+                    evidence = NativeFailureEvidence(
+                        exit_before_cleanup=before,
+                        exit_after_cleanup=process.returncode,
+                        parent_kill_requested=before is None,
+                        stdout=available(process.stdout.fileno()),
+                        stderr=available(process.stderr.fileno()),
+                        diagnostics=available(
+                            diagnostic_read, bytes(child.diagnostic_bytes)
+                        ),
+                    )
+                    target = outcome if outcome is not None else failure
+                    assert target is not None
+                    target.add_note(evidence.model_dump_json())
