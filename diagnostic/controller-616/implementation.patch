+import asyncio
+import json
+import os
+import select
+import sys
+import time
+from pathlib import Path
+
+from kora.conformance.capture import captured
+from kora.conformance.common import CONFORMANCE_COMPONENT, utc_now
+from kora.observability import LoggingSettings
+from kora.plugins.runtime.local.supervisor import EXIT_FAILED
+from kora.runner.registry import READY, Running
+from kora.runner.startup import validate_startup
+from tests.plugins.runtime.local.startup_native_parent import native_startup_child
+from tests.support.local_runners import (
+    open_spawning,
+    short_directory,
+    starting_entry,
+    written,
+)
+from tests.support.local_runtime import (
+    READY_DEADLINE_SECONDS,
+    recorded,
+    runtime_context,
+)
+
+
+async def collect(root: Path, mode: str) -> None:
+    root.mkdir(mode=0o700)
+    with captured(
+        CONFORMANCE_COMPONENT, LoggingSettings(), "startup-native-parent", utc_now
+    ) as capture:
+        ctx = runtime_context(capture)
+        with short_directory() as base:
+            runtime = await open_spawning(root, ctx, base / "sockets")
+            entry = starting_entry(base / "sockets", "a" * 32)
+            key = runtime.registry.key("attempt-1")
+            await written(runtime, key.attempt_id, entry, ctx)
+            try:
+                with native_startup_child(
+                    root, key.execution_domain_id, entry.nonce, mode
+                ) as child:
+                    os.write(
+                        1,
+                        json.dumps(
+                            {
+                                "phase": "prepared",
+                                "child_pid": child.process.pid,
+                                "mode": mode,
+                                "activation_required": mode == "blocked",
+                            }
+                        ).encode()
+                        + b"\n",
+                    )
+                    if mode == "blocked":
+                        readable, _, _ = select.select(
+                            [0], [], [], READY_DEADLINE_SECONDS
+                        )
+                        if not readable or os.read(0, 1) != b"G":
+                            raise TimeoutError("native fixture activation missing")
+                    activated = time.monotonic_ns()
+                    child.activate()
+                    ready = child.read(child.readiness, 1)
+                    if ready == READY:
+                        child.stop()
+                    code = child.process.wait(timeout=READY_DEADLINE_SECONDS)
+                    reaped = time.monotonic_ns()
+                    assert child.process.stdout is not None
+                    assert child.process.stderr is not None
+                    output = child.process.stdout.read()
+                    errors = child.process.stderr.read()
+                    head = await recorded(runtime, key.attempt_id)
+                    assert errors == b"", errors
+                    if mode == "normal":
+                        assert code == 0
+                        assert ready == READY
+                        assert output == b"normal-unwind\n"
+                        assert isinstance(head, Running)
+                        directory = (
+                            root / "attempts" / key.name / head.startup.directory
+                        )
+                        checkpoint = validate_startup(
+                            (directory / "journal.jsonl").read_bytes(),
+                            (directory / "checkpoint.json").read_bytes(),
+                            head.startup,
+                        )
+                        assert checkpoint.runner == head.runner
+                    else:
+                        assert code == EXIT_FAILED
+                        assert ready == b""
+                        assert output == b""
+                        assert head == entry
+                    os.write(
+                        1,
+                        json.dumps(
+                            {
+                                "phase": "reaped",
+                                "mode": mode,
+                                "exit_code": code,
+                                "activated_ns": activated,
+                                "reaped_ns": reaped,
+                                "ready": ready == READY,
+                                "normal_unwind": output == b"normal-unwind\n",
+                                "parent_kill": False,
+                                "native_syscall_evidence": "external trace required",
+                                "deadline_qualification": (
+                                    "not established by exit status"
+                                ),
+                            }
+                        ).encode()
+                        + b"\n",
+                    )
+            finally:
+                await runtime.close()
+
+
+def main() -> None:
+    root, mode = sys.argv[1:]
+    if mode not in {"normal", "blocked"}:
+        raise ValueError("native probe mode")
+    if os.geteuid() == 0:
+        raise ValueError("native runtime probe requires ordinary uid")
+    asyncio.run(collect(Path(root).resolve(), mode))
+
+
+if __name__ == "__main__":
+    main()
