+import errno
+import fcntl
+import os
+import sys
+import threading
+from contextlib import ExitStack
+from pathlib import Path
+from typing import Final, Literal
+
+from kora.protocols.errors import KoraProtocolError
+from kora.protocols.time import Clock
+from kora.runner.filesystem import (
+    DirectoryAnchor,
+    FilesystemError,
+    open_local_directory,
+    open_private_directory,
+    open_private_file,
+)
+from kora.runner.registry import (
+    F_FULLFSYNC,
+    LockOutcome,
+    Registry,
+    Starting,
+    Transition,
+)
+from kora.runner.startup import (
+    StartupCheckpoint,
+    StartupReference,
+    startup_bytes,
+    startup_digest,
+)
+
+SYNC_NS: Final[int] = 5_000_000_000
+CHECK_NS: Final[int] = 1_000_000
+StartupReason = Literal[
+    "no_space", "quota", "sync_timeout", "io_failure", "invalid_state"
+]
+
+
+class StartupFailure(Exception):
+    def __init__(self, reason: StartupReason) -> None:
+        super().__init__(reason)
+        self.reason: StartupReason = reason
+
+
+class StartupWriter:
+    def __init__(
+        self,
+        root: Path,
+        attempt: str,
+        directory: str,
+        journal: bytes,
+        checkpoint: StartupCheckpoint,
+        clock: Clock,
+    ) -> None:
+        self.root = root
+        self.attempt = attempt
+        self.directory = directory
+        self.journal = journal
+        self.state = checkpoint
+        self.checkpoint = startup_bytes(checkpoint)
+        self.clock = clock
+        self.deadline_ns = clock.monotonic_ns() + SYNC_NS
+        self.failure: StartupReason | None = None
+        self.durable = False
+        self.thread = threading.Thread(
+            target=self.write, name="kora-startup-writer", daemon=True
+        )
+        self.reference = StartupReference(
+            directory=directory, checkpoint_digest=startup_digest(self.checkpoint)
+        )
+
+    def synchronize(self, descriptor: int, *, data: bool = False) -> None:
+        if self.clock.monotonic_ns() >= self.deadline_ns:
+            raise StartupFailure("sync_timeout")
+        self.deadline_ns = self.clock.monotonic_ns() + SYNC_NS
+        if sys.platform == "darwin":
+            fcntl.fcntl(descriptor, F_FULLFSYNC)
+        elif data:
+            os.fdatasync(descriptor)
+        else:
+            os.fsync(descriptor)
+        if self.clock.monotonic_ns() >= self.deadline_ns:
+            raise StartupFailure("sync_timeout")
+
+    def write_bytes(self, descriptor: int, encoded: bytes) -> None:
+        remaining = memoryview(encoded)
+        while remaining:
+            if self.clock.monotonic_ns() >= self.deadline_ns:
+                raise StartupFailure("sync_timeout")
+            count = os.write(descriptor, remaining)
+            if count <= 0:
+                raise StartupFailure("io_failure")
+            remaining = remaining[count:]
+
+    def write(self) -> None:
+        try:
+            with ExitStack() as resources:
+                root = open_local_directory(self.root)
+                resources.callback(root.close)
+                attempts = open_private_directory(root, "attempts")
+                resources.callback(attempts.close)
+                attempt = open_private_directory(attempts, self.attempt)
+                resources.callback(attempt.close)
+                self.synchronize(root.descriptor)
+                self.synchronize(attempts.descriptor)
+                attempt.verify()
+                registry_directory = open_private_directory(root, "registry")
+                resources.callback(registry_directory.close)
+                registry = Registry(
+                    registry_directory,
+                    self.state.execution_domain_id,
+                    lambda: self.directory[33:],
+                )
+                key = registry.key(self.state.attempt_id)
+
+                def admit(entry: object) -> Transition:
+                    if (
+                        not isinstance(entry, Starting)
+                        or entry.nonce != self.state.launch_nonce
+                        or entry.fence is not None
+                        or entry.request_digest != self.state.request_digest
+                        or entry.workload_digest != self.state.workload_digest
+                        or entry.deadline != self.state.deadline
+                    ):
+                        raise StartupFailure("invalid_state")
+                    os.mkdir(self.directory, mode=0o700, dir_fd=attempt.descriptor)
+                    return Transition()
+
+                if isinstance(registry.try_transition(key, admit), LockOutcome):
+                    raise StartupFailure("invalid_state")
+                directory = open_private_directory(attempt, self.directory)
+                resources.callback(directory.close)
+                self.synchronize(attempt.descriptor)
+                self.persist(directory, "journal.jsonl", self.journal, append=True)
+                temporary = "checkpoint.json.tmp-" + self.directory[33:]
+                self.persist(directory, temporary, self.checkpoint, append=False)
+                directory.verify()
+                os.replace(
+                    temporary,
+                    "checkpoint.json",
+                    src_dir_fd=directory.descriptor,
+                    dst_dir_fd=directory.descriptor,
+                )
+                self.synchronize(directory.descriptor)
+            if self.clock.monotonic_ns() >= self.deadline_ns:
+                raise StartupFailure("sync_timeout")
+            self.durable = True
+        except StartupFailure as failure:
+            self.failure = failure.reason
+        except OSError as failure:
+            self.failure = (
+                "no_space"
+                if failure.errno == errno.ENOSPC
+                else "quota"
+                if failure.errno == errno.EDQUOT
+                else "io_failure"
+            )
+        except (FilesystemError, ValueError, KoraProtocolError):
+            self.failure = "invalid_state"
+
+    def persist(
+        self, directory: DirectoryAnchor, name: str, encoded: bytes, *, append: bool
+    ) -> None:
+        flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
+        if append:
+            flags |= os.O_APPEND
+        descriptor = open_private_file(directory, name, flags)
+        try:
+            self.write_bytes(descriptor, encoded)
+            self.synchronize(descriptor, data=True)
+        finally:
+            os.close(descriptor)
+
+    async def closed(self) -> StartupReference:
+        while self.thread.is_alive():
+            now = self.clock.monotonic_ns()
+            if now >= self.deadline_ns:
+                raise StartupFailure("sync_timeout")
+            await self.clock.sleep_until(min(self.deadline_ns, now + CHECK_NS))
+        self.thread.join(timeout=0)
+        if self.failure is not None:
+            raise StartupFailure(self.failure)
+        if not self.durable:
+            raise StartupFailure("invalid_state")
+        return self.reference
