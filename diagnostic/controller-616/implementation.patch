+def failed_native_child(root: Path, domain: str, nonce: str, failure: str) -> None:
+    with native_startup_child(root, domain, nonce, "normal") as child:
+        if failure == "parent":
+            raise RuntimeError("parent control failure")
+        if failure == "token":
+            assert child.process.stdin is not None
+            child.process.stdin.write(b"?")
+            child.process.stdin.flush()
+        else:
+            child.activate()
+        child.process.wait(timeout=READY_DEADLINE_SECONDS)
+        child.wait_registered()
+
