+@pytest.mark.asyncio
+async def test_startup_reference_survives_lost_readiness(
+    tmp_path: Path, kora_capture: Capture
+) -> None:
+    descriptors = open_descriptors()
+    root = state_root(tmp_path)
+    ctx = runtime_context(kora_capture)
+    with short_directory() as base:
+        runtime = await open_spawning(root, ctx, base / "sockets")
+        entry = starting_entry(base / "sockets", "a" * 32)
+        key = runtime.registry.key("attempt-1")
+        await written(runtime, key.attempt_id, entry, ctx)
+        try:
+            with native_startup_child(
+                root, key.execution_domain_id, entry.nonce, "normal"
+            ) as child:
+                child.readiness_stream.close()
+
+                child.activate()
+                child.wait_registered()
+                registered = await recorded(runtime, key.attempt_id)
+                assert isinstance(registered, Running)
+                observer = await client(registered.socket_path, ctx.clock)
+                try:
+                    status = await asked_status(observer, ctx.clock)
+                finally:
+                    observer.close()
+                retained = await recorded(runtime, key.attempt_id)
+                directory = root / "attempts" / key.name / registered.startup.directory
+                checkpoint = validate_startup(
+                    (directory / "journal.jsonl").read_bytes(),
+                    (directory / "checkpoint.json").read_bytes(),
+                    registered.startup,
+                )
+                child.stop()
+                code = child.process.wait(timeout=READY_DEADLINE_SECONDS)
+                assert child.process.stdout is not None
+                assert child.process.stderr is not None
+                output = child.process.stdout.read()
+                errors = child.process.stderr.read()
+
+            assert code == 0, errors
+            assert output == b"normal-unwind\n"
+            assert status.status.state == "starting"
+            assert retained == registered
+            assert registered.runner.pid == child.process.pid
+            assert checkpoint.runner == registered.runner
+            assert checkpoint.launch_nonce == entry.nonce
+            assert checkpoint.request_digest == entry.request_digest
+            assert checkpoint.workload_digest == entry.workload_digest
+            assert [
+                path.name for path in directory.parent.iterdir() if path.is_dir()
+            ] == [registered.startup.directory]
+        finally:
+            await runtime.close()
+
+    assert open_descriptors() == descriptors
