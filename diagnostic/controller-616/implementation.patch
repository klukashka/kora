+@pytest.mark.asyncio
+@pytest.mark.parametrize("mode", ["normal", "blocked", "before-append", "partial"])
+async def test_real_supervisor_native_partial_append(
+    tmp_path: Path, kora_capture: Capture, mode: str
+) -> None:
+    descriptors = open_descriptors()
+    root = state_root(tmp_path)
+    ctx = runtime_context(kora_capture)
+    with short_directory() as base:
+        runtime = await open_spawning(root, ctx, base / "sockets")
+        entry = starting_entry(base / "sockets", "a" * 32)
+        key = runtime.registry.key("attempt-1")
+        await written(runtime, key.attempt_id, entry, ctx)
+        try:
+            with native_startup_child(
+                root, key.execution_domain_id, entry.nonce, mode
+            ) as child:
+                child.activate()
+                ready = child.read(child.readiness, 1)
+                if mode in {"normal", "blocked"}:
+                    child.stop()
+                code = child.process.wait(timeout=READY_DEADLINE_SECONDS)
+                assert child.process.stdout is not None
+                assert child.process.stderr is not None
+                output = child.process.stdout.read()
+                errors = child.process.stderr.read()
+                stored = await recorded(runtime, key.attempt_id)
+            attempts = root / "attempts" / key.name
+            startup_directories = [path for path in attempts.iterdir() if path.is_dir()]
+            assert len(startup_directories) == 1
+            directory = startup_directories[0]
+            journal = (directory / "journal.jsonl").read_bytes()
+            if mode in {"normal", "blocked"}:
+                assert code == 0, errors
+                assert ready == READY
+                assert output == b"normal-unwind\n"
+                assert isinstance(stored, Running)
+                checkpoint = validate_startup(
+                    journal,
+                    (directory / "checkpoint.json").read_bytes(),
+                    stored.startup,
+                )
+                assert checkpoint.runner == stored.runner
+                assert checkpoint.launch_nonce == entry.nonce
+            else:
+                assert code == -signal.SIGXFSZ, errors
+                assert ready == b""
+                assert output == b""
+                assert errors == b""
+                assert journal == (b"{" if mode == "partial" else b"")
+                assert stored == entry
+                assert isinstance(stored, Starting)
+                assert {path.name for path in directory.iterdir()} == {"journal.jsonl"}
+        finally:
+            await runtime.close()
+
+    assert open_descriptors() == descriptors
