+import asyncio
+import os
+import resource
+import signal
+import sys
+from datetime import UTC, datetime
+from pathlib import Path
+
+from kora.observability import Level, LoggingSettings, configure_process
+from kora.plugins.runtime.local.supervisor import (
+    COMPONENT,
+    EXIT_FAILED,
+    EXIT_REFUSED,
+    STARTED,
+    RunnerArguments,
+    RunnerRefused,
+    attempt_directory,
+    harden,
+    supervise,
+)
+from kora.protocols.errors import KoraProtocolError
+from kora.runner.filesystem import FilesystemError
+from kora.runner.registry import READINESS_DESCRIPTOR
+
+
+async def stop_requested() -> None:
+    loop = asyncio.get_running_loop()
+    stopped: asyncio.Future[None] = loop.create_future()
+
+    def readable() -> None:
+        token = os.read(0, 1)
+        if not stopped.done():
+            if token == b"X":
+                stopped.set_result(None)
+            else:
+                stopped.set_exception(ValueError("parent stop token"))
+        loop.remove_reader(0)
+
+    loop.add_reader(0, readable)
+    try:
+        await stopped
+    finally:
+        loop.remove_reader(0)
+
+
+async def exercise(arguments: RunnerArguments, diagnostics_descriptor: int) -> None:
+    diagnostics = configure_process(
+        COMPONENT,
+        LoggingSettings(level=Level.DEBUG),
+        "startup-native-fixture",
+        lambda: datetime.now(UTC),
+        descriptor=diagnostics_descriptor,
+    )
+    log = diagnostics.logger(COMPONENT)
+    log.emit(STARTED)
+    running = asyncio.create_task(supervise(arguments, log))
+    stopping = asyncio.create_task(stop_requested())
+    try:
+        finished, _ = await asyncio.wait(
+            (running, stopping), return_when=asyncio.FIRST_COMPLETED
+        )
+        if running in finished:
+            await running
+        else:
+            await stopping
+    finally:
+        running.cancel()
+        stopping.cancel()
+        await asyncio.gather(running, stopping, return_exceptions=True)
+        os.write(1, b"normal-unwind\n")
+        diagnostics.shutdown()
+
+
+def main() -> int:
+    root, domain, nonce, mode, ready, diagnostic = sys.argv[1:]
+    if mode not in {"normal", "before-append", "partial", "blocked"}:
+        raise ValueError("native case")
+    harden()
+    readiness = int(ready)
+    descriptor = int(diagnostic)
+    if readiness != READINESS_DESCRIPTOR:
+        os.dup2(readiness, READINESS_DESCRIPTOR)
+        os.close(readiness)
+    arguments = RunnerArguments(Path(root), "attempt-1", domain, nonce)
+    attempt_directory(arguments).close()
+    if mode == "blocked":
+        os.set_blocking(descriptor, False)
+        try:
+            while True:
+                os.write(descriptor, bytes(4096))
+        except BlockingIOError:
+            os.set_blocking(descriptor, True)
+    os.write(1, b"prepared\n")
+    if os.read(0, 1) != b"G":
+        raise ValueError("parent activation token")
+    if mode in {"before-append", "partial"}:
+        signal.signal(signal.SIGXFSZ, signal.SIG_DFL)
+        limit = 1 if mode == "partial" else 0
+        resource.setrlimit(resource.RLIMIT_FSIZE, (limit, limit))
+    try:
+        asyncio.run(exercise(arguments, descriptor))
+    except RunnerRefused:
+        return EXIT_REFUSED
+    except (KoraProtocolError, OSError, FilesystemError):
+        return EXIT_FAILED
+    finally:
+        os.close(descriptor)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
