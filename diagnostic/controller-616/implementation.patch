+    AttemptKey,
+    Entry,
+    LockOutcome,
+    Registry,
+    Running,
+    Starting,
+    Transition,
+    refusal,
+    synchronize,
+)
+
+STARTUP_NAME: re.Pattern[str] = re.compile(r"[0-9a-f]{32}-[0-9a-f]{32}")
+
+
+def cleanup_startup(
+    root: DirectoryAnchor,
+    registry: Registry,
+    key: AttemptKey,
+    nonce: str,
+    clock: Clock,
+    deadline_ns: int,
+    allowed: Callable[[Entry | None], bool],
+    cancelled: threading.Event,
+) -> None:
+    def current() -> None:
+        if cancelled.is_set() or clock.monotonic_ns() >= deadline_ns:
+            raise refusal("registry_busy")
+
+    with_anchor = root
+    try:
+        attempts = open_private_directory(with_anchor, "attempts")
+    except FileNotFoundError:
+        return
+    try:
+        try:
+            attempt = open_private_directory(attempts, key.name)
+        except FileNotFoundError:
+            return
+        try:
+            with os.scandir(attempt.descriptor) as entries:
+                for candidate in entries:
+                    current()
+                    name = candidate.name
+                    if not STARTUP_NAME.fullmatch(name) or name[:32] != nonce:
+                        continue
+                    directory = open_private_directory(attempt, name)
+                    try:
+                        files = (
+                            "journal.jsonl",
+                            "checkpoint.json",
+                            "checkpoint.json.tmp-" + name[33:],
+                        )
+                        with os.scandir(directory.descriptor) as contents:
+                            for content in contents:
+                                current()
+                                if content.name not in files:
+                                    raise FilesystemError("unexpected_startup_file")
+                        for filename in (*files, None):
+                            current()
+
+                            def remove(
+                                entry: Entry | None,
+                                name: str = name,
+                                directory: DirectoryAnchor = directory,
+                                filename: str | None = filename,
+                            ) -> Transition:
+                                current()
+                                if not allowed(entry) or (
+                                    isinstance(entry, Running)
+                                    and entry.startup.directory == name
+                                ):
+                                    raise refusal("retirement_unavailable")
+                                confirming = attempt.open_child(directory.identity)
+                                confirming.close()
+                                if filename is None:
+                                    current()
+                                    os.rmdir(name, dir_fd=attempt.descriptor)
+                                else:
+                                    try:
+                                        descriptor = open_private_file(
+                                            directory, filename, os.O_RDONLY
+                                        )
+                                    except FileNotFoundError:
+                                        return Transition()
+                                    try:
+                                        expected = file_identity(descriptor, filename)
+                                        actual = os.stat(
+                                            filename,
+                                            dir_fd=directory.descriptor,
+                                            follow_symlinks=False,
+                                        )
+                                        if (actual.st_dev, actual.st_ino) != (
+                                            expected.device,
+                                            expected.inode,
+                                        ):
+                                            raise FilesystemError(
+                                                "startup_file_changed"
+                                            )
+                                        current()
+                                        os.unlink(filename, dir_fd=directory.descriptor)
+                                    finally:
+                                        os.close(descriptor)
+                                current()
+                                return Transition()
+
+                            if isinstance(
+                                registry.try_inspection(key, remove), LockOutcome
+                            ):
+                                raise refusal("registry_busy")
+                            synchronize(
+                                attempt.descriptor
+                                if filename is None
+                                else directory.descriptor
+                            )
+                            current()
+                    finally:
+                        directory.close()
+            current()
+            synchronize(attempt.descriptor)
+            current()
+        finally:
+            attempt.close()
+    finally:
+        attempts.close()
+
+
+def fenced_startup(entry: Entry | None, expected: Starting) -> bool:
+    return (
+        isinstance(entry, Starting)
+        and entry.nonce == expected.nonce
+        and entry.fence is not None
+        and entry.fence == expected.fence
+    )
+
+
+def cleanup_job(
+    root: Path,
+    root_identity: DirectoryIdentity,
+    registry_identity: DirectoryIdentity,
+    key: AttemptKey,
+    expected: Starting,
+    clock: Clock,
+    deadline_ns: int,
+    cancelled: threading.Event,
+) -> KoraProtocolError | None:
+    try:
+        anchor = open_local_directory(root)
+        try:
+            if anchor.identity != root_identity:
+                raise FilesystemError("startup_root_changed")
+            directory = anchor.open_child(registry_identity)
+            try:
+                registry = Registry(
+                    directory, key.execution_domain_id, lambda: expected.nonce
+                )
+                cleanup_startup(
+                    anchor,
+                    registry,
+                    key,
+                    expected.nonce,
+                    clock,
+                    deadline_ns,
+                    lambda entry: fenced_startup(entry, expected),
+                    cancelled,
+                )
+            finally:
+                directory.close()
+        finally:
+            anchor.close()
+    except (OSError, FilesystemError):
+        return refusal("retirement_unavailable")
+    except KoraProtocolError as failure:
+        return failure
+    return None
+
+
+@dataclass
+class CleanupOperation:
+    future: asyncio.Future[KoraProtocolError | None]
+    cancelled: threading.Event
+    key: AttemptKey
+    expected: Starting
+    clock: Clock
+    waiters: int = 0
+
+
+class StartupCleanup:
+    def __init__(
+        self, root_identity: DirectoryIdentity, registry_identity: DirectoryIdentity
+    ) -> None:
+        self.root_identity = root_identity
+        self.registry_identity = registry_identity
+        self.executor = ThreadPoolExecutor(
+            max_workers=1, thread_name_prefix="kora-startup-cleanup"
+        )
+        self.operation: CleanupOperation | None = None
+        self.stopping: asyncio.Future[None] = asyncio.get_running_loop().create_future()
+
+    @property
+    def job(self) -> asyncio.Future[KoraProtocolError | None] | None:
+        return None if self.operation is None else self.operation.future
+
+    async def run(
+        self,
+        root: Path,
+        key: AttemptKey,
+        expected: Starting,
+        clock: Clock,
+        deadline_ns: int,
+    ) -> None:
+        if self.stopping.done():
+            raise refusal("runtime_closed")
+        if clock.monotonic_ns() >= deadline_ns:
+            raise refusal("registry_busy")
+        operation = self.operation
+        if operation is None or operation.future.done():
+            if operation is not None:
+                operation.future.result()
+            cancelled = threading.Event()
+            job = asyncio.get_running_loop().run_in_executor(
+                self.executor,
+                partial(
+                    cleanup_job,
+                    root,
+                    self.root_identity,
+                    self.registry_identity,
+                    key,
+                    expected,
+                    clock,
+                    deadline_ns,
+                    cancelled,
+                ),
+            )
+            operation = CleanupOperation(job, cancelled, key, expected, clock)
+            self.operation = operation
+        elif (
+            operation.cancelled.is_set()
+            or operation.key != key
+            or operation.expected != expected
+            or operation.clock is not clock
+            or operation.waiters >= 4
+        ):
+            raise refusal("registry_busy")
+        operation.waiters += 1
+        timer = asyncio.create_task(clock.sleep_until(deadline_ns))
+        try:
+            await asyncio.wait(
+                (operation.future, timer, self.stopping),
+                return_when=asyncio.FIRST_COMPLETED,
+            )
+            if self.stopping.done():
+                raise refusal("runtime_closed")
+            if timer.done():
+                timer.result()
+            if clock.monotonic_ns() >= deadline_ns:
+                raise refusal("registry_busy")
+            failure = operation.future.result()
+            if failure is not None:
+                raise failure
+        finally:
+            operation.waiters -= 1
+            if operation.waiters == 0:
+                operation.cancelled.set()
+            await cancel_task(timer)
+
+    def stop(self) -> None:
+        if self.operation is not None:
+            self.operation.cancelled.set()
+        if not self.stopping.done():
+            self.stopping.set_result(None)
+
+    async def close(self) -> None:
+        self.stop()
+        try:
+            if self.operation is not None:
+                await asyncio.shield(self.operation.future)
+        finally:
+            self.executor.shutdown(wait=True)
