+import hashlib
+from datetime import datetime
+from typing import Annotated, Final, Literal, Self
+
+from pydantic import Field, StringConstraints, model_validator
+
+from kora.ir.json import JsonObject, parse_json_object
+from kora.ir.scalars import Digest
+from kora.ir.vcs_ref_json import JsonRefusal, canonical_bytes, decode_strict_json
+from kora.protocols.boundary import BoundaryModel
+from kora.protocols.deadlines import ExecutionDeadline
+from kora.protocols.identity import Count, Identifier, Instant, ProcessIdentity
+from kora.runner.identity import complete_identity
+
+STARTUP_LIMIT: Final[int] = 16384
+StartupNonce = Annotated[str, StringConstraints(strict=True, pattern=r"^[0-9a-f]{32}$")]
+StartupDirectory = Annotated[
+    str, StringConstraints(strict=True, pattern=r"^[0-9a-f]{32}-[0-9a-f]{32}$")
+]
+
+
+class StartupData(BoundaryModel):
+    stage: Literal["registration_pending"]
+    launch_nonce: StartupNonce
+    request_digest: Digest
+    workload_digest: Digest
+
+
+class StartupRecord(BoundaryModel):
+    i: Annotated[Count, Field(le=0)]
+    at: Instant
+    kind: Literal["runner.started"]
+    data: StartupData
+
+
+class StartupCheckpoint(BoundaryModel):
+    format: Literal["local-startup-checkpoint/1"]
+    execution_domain_id: Identifier
+    attempt_id: Identifier
+    request_digest: Digest
+    workload_digest: Digest
+    runner: ProcessIdentity
+    deadline: ExecutionDeadline | None
+    stage: Literal["registration_pending"]
+    launch_nonce: StartupNonce
+    journal_next: Annotated[Count, Field(ge=1, le=1)]
+    journal_end: Annotated[Count, Field(ge=1, le=STARTUP_LIMIT)]
+    record_digest: Digest
+
+    @model_validator(mode="after")
+    def complete_runner(self) -> Self:
+        if not complete_identity(self.runner):
+            raise ValueError("the startup runner identity is incomplete")
+        return self
+
+
+class StartupReference(BoundaryModel):
+    directory: StartupDirectory
+    checkpoint_digest: Digest
+
+
+def startup_digest(encoded: bytes) -> str:
+    return "sha256:" + hashlib.sha256(encoded).hexdigest()
+
+
+def startup_bytes(model: BoundaryModel, *, newline: bool = False) -> bytes:
+    encoded = canonical_bytes(parse_json_object(model.model_dump(mode="json")))
+    if newline:
+        encoded += b"\n"
+    if len(encoded) > STARTUP_LIMIT:
+        raise ValueError("the startup encoding exceeds its bound")
+    return encoded
+
+
+def startup_object(encoded: bytes) -> JsonObject:
+    value = decode_strict_json(encoded, STARTUP_LIMIT, 8)
+    if isinstance(value, JsonRefusal) or not isinstance(value, dict):
+        raise ValueError("the startup encoding is invalid")
+    return value
+
+
+def startup_record(
+    at: datetime, nonce: str, request: str, workload: str
+) -> StartupRecord:
+    return StartupRecord(
+        i=0,
+        at=at,
+        kind="runner.started",
+        data=StartupData(
+            stage="registration_pending",
+            launch_nonce=nonce,
+            request_digest=request,
+            workload_digest=workload,
+        ),
+    )
+
+
+def validate_startup(
+    journal: bytes, checkpoint: bytes, reference: StartupReference
+) -> StartupCheckpoint:
+    if not journal.endswith(b"\n") or len(journal) > STARTUP_LIMIT:
+        raise ValueError("the startup journal is incomplete")
+    record = StartupRecord.model_validate(startup_object(journal[:-1]))
+    state = StartupCheckpoint.model_validate(startup_object(checkpoint))
+    if (
+        startup_bytes(record, newline=True) != journal
+        or startup_bytes(state) != checkpoint
+        or reference.checkpoint_digest != startup_digest(checkpoint)
+        or reference.directory[:32] != state.launch_nonce
+        or state.journal_end != len(journal)
+        or state.record_digest != startup_digest(journal[:-1])
+        or record.data.launch_nonce != state.launch_nonce
+        or record.data.request_digest != state.request_digest
+        or record.data.workload_digest != state.workload_digest
+    ):
+        raise ValueError("the startup binding differs")
+    return state
