+class HeldCleanupClock(StepClock):
+    def __init__(self) -> None:
+        super().__init__()
+        self.loop = asyncio.get_running_loop()
+        self.entered = asyncio.Event()
+        self.release = threading.Event()
+
+    def monotonic_ns(self) -> int:
+        if (
+            threading.current_thread().name.startswith("kora-startup-cleanup")
+            and not self.release.is_set()
+        ):
+            self.loop.call_soon_threadsafe(self.entered.set)
+            if not self.release.wait(5):
+                raise TimeoutError("cleanup clock was not released")
+        return super().monotonic_ns()
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("ending", ["deadline", "cancel", "close"])
+async def test_cleanup_retains_job_after_waiter_ends(
+    tmp_path: Path, kora_capture: Capture, ending: str
+) -> None:
+    descriptors = open_descriptors()
+    root = state_root(tmp_path)
+    ctx = runtime_context(kora_capture)
+    clock = HeldCleanupClock()
+    with short_directory() as base:
+        runtime = await open_spawning(root, ctx, base / "sockets")
+        entry = starting_entry(
+            base / "sockets",
+            "a" * 32,
+            Fence(retirement_id="fence", fenced_at=ctx.clock.now()),
+        )
+        key = runtime.registry.key("attempt-1")
+        await written(runtime, key.attempt_id, entry, ctx)
+        attempt_directory(
+            RunnerArguments(root, key.attempt_id, key.execution_domain_id, entry.nonce)
+        ).close()
+        directory = root / "attempts" / key.name / (entry.nonce + "-" + "b" * 32)
+        directory.mkdir(mode=0o700)
+        content = directory / "journal.jsonl"
+        content.write_bytes(b"owned startup")
+        content.chmod(0o600)
+        deadline = clock.monotonic_ns() + 1_000_000_000
+        operation = asyncio.create_task(
+            runtime.startup_cleanup.run(root, key, entry, clock, deadline)
+        )
+        try:
+            await asyncio.wait_for(clock.entered.wait(), 5)
+
+            if ending == "deadline":
+                clock.advance(1_000_000_000)
+            elif ending == "cancel":
+                operation.cancel()
+            else:
+                runtime.startup_cleanup.stop()
+            if ending == "cancel":
+                with pytest.raises(asyncio.CancelledError):
+                    await asyncio.wait_for(operation, 5)
+            else:
+                with pytest.raises(KoraProtocolError):
+                    await asyncio.wait_for(operation, 5)
+            job = runtime.startup_cleanup.job
+            assert job is not None
+            assert not job.done()
+            with pytest.raises(KoraProtocolError) as refused:
+                await runtime.startup_cleanup.run(
+                    root, key, entry, clock, deadline + 1_000_000_000
+                )
+            assert refused.value.code == (
+                "runtime_closed" if ending == "close" else "registry_busy"
+            )
+            assert (
+                await runtime.sweeps.run(lambda: runtime.registry.entry(key)) == entry
+            )
+            assert content.read_bytes() == b"owned startup"
+            assert runtime.startup_cleanup.job is job
+        finally:
+            clock.release.set()
+            await runtime.close()
+            await asyncio.gather(operation, return_exceptions=True)
+
+    assert content.read_bytes() == b"owned startup"
+    assert job.done()
+    assert open_descriptors() == descriptors
+
