+@pytest.mark.asyncio
+@pytest.mark.parametrize("failure", ["lock", "token", "parent"])
+async def test_native_failure_retains_child_evidence(
+    tmp_path: Path, kora_capture: Capture, failure: str
+) -> None:
+    descriptors = open_descriptors()
+    root = state_root(tmp_path)
+    ctx = runtime_context(kora_capture)
+    with short_directory() as base:
+        runtime = await open_spawning(root, ctx, base / "sockets")
+        entry = starting_entry(base / "sockets", "a" * 32)
+        key = runtime.registry.key("attempt-1")
+        await written(runtime, key.attempt_id, entry, ctx)
+        lock = root / "registry" / f"{key.name}.lock"
+        held = stopped_holder(lock) if failure == "lock" else nullcontext()
+        try:
+            with held, pytest.raises(RuntimeError) as raised:
+                failed_native_child(root, key.execution_domain_id, entry.nonce, failure)
+            evidence = NativeFailureEvidence.model_validate_json(
+                raised.value.__notes__[0]
+            )
+            retained = await recorded(runtime, key.attempt_id)
+        finally:
+            await runtime.close()
+
+    assert retained == entry
+    assert not evidence.stdout.truncated
+    assert not evidence.stderr.truncated
+    assert not evidence.diagnostics.truncated
+    if failure == "parent":
+        assert str(raised.value) == "parent control failure"
+        assert evidence.exit_before_cleanup is None
+        assert evidence.exit_after_cleanup == -signal.SIGKILL
+        assert evidence.parent_kill_requested
+    else:
+        assert str(raised.value) == "native diagnostics closed before registration"
+        assert evidence.exit_before_cleanup == evidence.exit_after_cleanup
+        assert not evidence.parent_kill_requested
+        if failure == "lock":
+            assert evidence.exit_after_cleanup == 3
+            assert evidence.stdout.data == "normal-unwind\n"
+            assert evidence.stderr.data == ""
+            assert '"reason":"invalid_state"' in evidence.diagnostics.data
+            assert (
+                '"event":"runtime.local.runner.startup_refused"'
+                in evidence.diagnostics.data
+            )
+        else:
+            assert evidence.exit_after_cleanup == 1
+            assert "ValueError: parent activation token" in evidence.stderr.data
+            assert evidence.stdout.data == ""
+            assert evidence.diagnostics.data == ""
+    assert open_descriptors() == descriptors
