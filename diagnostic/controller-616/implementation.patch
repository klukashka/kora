+import ast
+from pathlib import Path
+
+import pytest
+
+from tests.architecture.test_no_suppression import BANNED_API
+
+SUPERVISOR: str = "src/kora/plugins/runtime/local/supervisor.py"
+
+
+def qualified(node: ast.expr, imports: dict[str, str]) -> str:
+    if isinstance(node, ast.Name):
+        return imports.get(node.id, node.id)
+    if isinstance(node, ast.Attribute):
+        return qualified(node.value, imports) + "." + node.attr
+    return ""
+
+
+def forbidden_apis(text: str) -> set[str]:
+    tree = ast.parse(text)
+    imports: dict[str, str] = {}
+    violations: set[str] = set()
+    for node in ast.walk(tree):
+        if isinstance(node, ast.Import):
+            for name in node.names:
+                imports[name.asname or name.name.split(".")[0]] = (
+                    name.name if name.asname else name.name.split(".")[0]
+                )
+                if any(
+                    name.name == banned or name.name.startswith(banned + ".")
+                    for banned in BANNED_API
+                ):
+                    violations.add(name.name)
+        if isinstance(node, ast.ImportFrom):
+            for name in node.names:
+                target = (node.module or "") + "." + name.name
+                imports[name.asname or name.name] = target
+                if any(
+                    target == banned or target.startswith(banned + ".")
+                    for banned in BANNED_API
+                ):
+                    violations.add(target)
+    for node in ast.walk(tree):
+        if isinstance(node, ast.expr):
+            target = qualified(node, imports)
+            if target != "os._exit" and any(
+                target == banned or target.startswith(banned + ".")
+                for banned in BANNED_API
+            ):
+                violations.add(target)
+    return violations
+
+
+def test_supervisor_retains_every_other_banned_api() -> None:
+    source = Path(SUPERVISOR).read_text()
+
+    violations = forbidden_apis(source)
+
+    assert not violations
+
+
+@pytest.mark.parametrize("target", [name for name in BANNED_API if name != "os._exit"])
+def test_other_banned_apis_remain_detectable(target: str) -> None:
+    module, attribute = target.rsplit(".", 1) if "." in target else (target, "")
+    source = f"import {module} as alias\nalias" + ("." + attribute if attribute else "")
+
+    violations = forbidden_apis(source)
+
+    assert violations
+
+
+def test_startup_abort_is_one_exact_pre_registration_call() -> None:
+    tree = ast.parse(Path(SUPERVISOR).read_text())
+    helper = next(
+        node
+        for node in tree.body
+        if isinstance(node, ast.FunctionDef) and node.name == "abort_startup"
+    )
+    controller = next(
+        node
+        for node in tree.body
+        if isinstance(node, ast.AsyncFunctionDef)
+        and node.name == "startup_before_registration"
+    )
+    expected = ast.parse(
+        "def abort_startup() -> NoReturn:\n    os._exit(EXIT_FAILED)"
+    ).body[0]
+
+    accesses = [
+        node
+        for node in ast.walk(tree)
+        if isinstance(node, ast.Attribute) and node.attr == "_exit"
+    ]
+    uses = [
+        node
+        for node in ast.walk(tree)
+        if isinstance(node, ast.Name) and node.id == "abort_startup"
+    ]
+    guarded = [
+        node
+        for node in ast.walk(controller)
+        if isinstance(node, ast.If)
+        and ast.unparse(node.test) == "writer.thread.is_alive()"
+    ]
+
+    assert ast.dump(helper) == ast.dump(expected)
+    assert len(accesses) == 1
+    assert len(uses) == 1
+    assert len(guarded) == 1
+    assert ast.unparse(guarded[0].body[0]) == "abort_startup()"
+    assert uses[0] in list(ast.walk(guarded[0]))
+    assert not any(
+        isinstance(node, ast.ImportFrom)
+        and any(name.name == "_exit" for name in node.names)
+        for node in ast.walk(tree)
+    )
+    assert not any(
+        isinstance(node, ast.Call)
+        and isinstance(node.func, ast.Name)
+        and node.func.id in {"register", "signal_ready"}
+        for node in ast.walk(controller)
+    )
+
+
+def references_abort(text: str) -> bool:
+    tree = ast.parse(text)
+    for node in ast.walk(tree):
+        if isinstance(node, ast.Name) and node.id == "abort_startup":
+            return True
+        if isinstance(node, ast.Attribute) and node.attr == "abort_startup":
+            return True
+        if isinstance(node, ast.alias) and node.name == "abort_startup":
+            return True
+        if isinstance(node, ast.Constant) and node.value == "abort_startup":
+            return True
+    return False
+
+
+def test_only_supervisor_references_abort() -> None:
+    paths = tuple(
+        path for path in Path("src").rglob("*.py") if path.as_posix() != SUPERVISOR
+    )
+
+    consumers = [path for path in paths if references_abort(path.read_text())]
+
+    assert not consumers
+
+
+@pytest.mark.parametrize(
+    "source",
+    [
+        "from kora.plugins.runtime.local.supervisor import "
+        "abort_startup as stop\nstop()",
+        "import kora.plugins.runtime.local.supervisor as entry\nentry.abort_startup()",
+        'getattr(entry, "abort_startup")()',
+        "stop = abort_startup\nstop()",
+    ],
+)
+def test_external_abort_consumers_are_refused(source: str) -> None:
+    candidate = source
+
+    forbidden = references_abort(candidate)
+
+    assert forbidden
